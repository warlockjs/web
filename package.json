{
  "name": "@warlock.js/web",
  "version": "5.2.4",
  "type": "module",
  "description": "Warlock.js web layer for the SSR page pipeline and client runtime.",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "universal"
  },
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client/runtime": {
      "types": "./src/client/runtime/index.ts",
      "import": "./src/client/runtime/index.ts",
      "default": "./src/client/runtime/index.ts"
    },
    "./connector": {
      "types": "./src/connector/index.ts",
      "import": "./src/connector/index.ts",
      "default": "./src/connector/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts",
      "default": "./src/vite/index.ts"
    }
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "vite build && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/types": "^7.29.7",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "@warlock.js/core": "5.2.2",
    "@warlock.js/seal": "5.2.2",
    "react": "*",
    "react-dom": "*",
    "vite": ">=7.3.5 <8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/web"
  },
  "keywords": [
    "warlock",
    "ssr",
    "react",
    "web"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@warlock.js/context": "workspace:^",
    "@warlock.js/core": "workspace:^",
    "@warlock.js/seal": "workspace:^",
    "esbuild": "^0.27.2",
    "fastify": "^5.6.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.24.0"
}
