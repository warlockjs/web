{
  "name": "@warlock.js/web",
  "version": "5.20.1",
  "type": "module",
  "description": "Warlock.js web layer for the SSR page pipeline and client runtime.",
  "main": "./src/index.ts",
  "warlock": {
    "environment": "universal"
  },
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build/index.ts",
      "import": "./src/build/index.ts",
      "default": "./src/build/index.ts"
    },
    "./client/runtime": {
      "types": "./src/client/runtime/index.ts",
      "import": "./src/client/runtime/index.ts",
      "default": "./src/client/runtime/index.ts"
    },
    "./connector": {
      "types": "./src/connector/index.ts",
      "import": "./src/connector/index.ts",
      "default": "./src/connector/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "import": "./src/form/index.ts",
      "default": "./src/form/index.ts"
    },
    "./page-cache": {
      "types": "./src/page-cache.ts",
      "import": "./src/page-cache.ts",
      "default": "./src/page-cache.ts"
    },
    "./sitemap": {
      "types": "./src/sitemap/index.ts",
      "import": "./src/sitemap/index.ts",
      "default": "./src/sitemap/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts",
      "default": "./src/vite/index.ts"
    }
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "vite build && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "format:check": "node ../node_modules/prettier/bin/prettier.cjs --check src __tests__",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.7",
    "@mongez/localization": "^3.5.1",
    "@warlock.js/sitemap": "workspace:^",
    "devalue": "^5.9.2",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "@mongez/http": "^3.5.1",
    "@mongez/react-form": "^4.0.0",
    "@warlock.js/cache": "5.20.1",
    "@warlock.js/cascade": "5.20.1",
    "@warlock.js/core": "5.20.1",
    "@warlock.js/seal": "5.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=7.3.5 <8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@warlock.js/cache": {
      "optional": true
    },
    "@warlock.js/cascade": {
      "optional": true
    },
    "@mongez/http": {
      "optional": true
    },
    "@mongez/react-form": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/warlockjs/web"
  },
  "keywords": [
    "warlock",
    "ssr",
    "react",
    "web"
  ],
  "author": "hassanzohdy",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^5.2.0",
    "@warlock.js/cache": "workspace:^",
    "@warlock.js/cascade": "workspace:^",
    "@warlock.js/context": "workspace:^",
    "@warlock.js/core": "workspace:^",
    "@warlock.js/seal": "workspace:^",
    "esbuild": "^0.27.2",
    "fastify": "^5.6.2",
    "jsdom": "30.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.24.0"
}
